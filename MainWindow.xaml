<Window x:Class="UfoTwCsvConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UFO-TW CSV 转 Funscript"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Microsoft YaHei UI"
        AllowDrop="True"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock x:Name="TitleText"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#253746"
                       Text="UFO-TW CSV 转 Funscript" />
            <ComboBox x:Name="LanguageSelector"
                      Width="120"
                      Height="30"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      SelectionChanged="LanguageSelector_OnSelectionChanged"
                      SelectedIndex="0">
                <ComboBoxItem Content="中文" />
                <ComboBoxItem Content="English" />
            </ComboBox>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="16"
                Background="#E8F1F6"
                CornerRadius="8">
            <TextBlock x:Name="InfoText"
                       Foreground="#365466"
                       TextWrapping="Wrap"
                       Text="支持 UFO-TW 的三列 CSV（时间,极性,力度）和五列 CSV（时间,左极性,左力度,右极性,右力度）。时间单位为 100 毫秒；极性 0 为正转，1 为反转。输出映射：0～49 反转，50 停止，51～100 正转。" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="SelectButton"
                        Width="120"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="SelectButton_OnClick"
                        Content="选择 CSV" />
                <Button x:Name="ClearButton"
                        Width="100"
                        Height="34"
                        Margin="0,0,10,10"
                        Click="ClearButton_OnClick"
                        Content="清空列表" />
                <TextBlock x:Name="DragHintText"
                           VerticalAlignment="Center"
                           Margin="4,0,0,10"
                           Foreground="#6A7780"
                           Text="也可以把 CSV 拖到窗口中" />
            </StackPanel>

            <ListBox x:Name="FileList"
                     Grid.Row="1"
                     MinHeight="180"
                     Padding="8"
                     Background="White"
                     BorderBrush="#CBD6DD"
                     BorderThickness="1" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,12">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="StripSuffixCheckBox"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Content="如果文件名以 _ufotw 或 .ufotw 结尾，自动去掉该后缀" />
                <TextBlock x:Name="AxisTargetLabel"
                           Margin="22,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="#4D5B63"
                           Text="三列目标：" />
                <ComboBox x:Name="AxisTargetSelector"
                          Width="115"
                          Height="28"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem x:Name="AxisAutoItem" Content="自动判断" />
                    <ComboBoxItem x:Name="AxisBothItem" Content="左右两侧" />
                    <ComboBoxItem x:Name="AxisLeftItem" Content="仅左侧" />
                    <ComboBoxItem x:Name="AxisRightItem" Content="仅右侧" />
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="OutputHintText"
                       Margin="0,8,0,0"
                       Foreground="#66737B"
                       Text="五列 CSV 会生成左右两个文件；三列 CSV 会根据文件名或上面的选项生成左侧、右侧或左右两个文件。" />
        </StackPanel>

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#4D5B63"
                       Text="等待选择 CSV 文件。" />
            <Button x:Name="ConvertButton"
                    Width="150"
                    Height="40"
                    DockPanel.Dock="Right"
                    Click="ConvertButton_OnClick"
                    Content="开始转换"
                    FontWeight="SemiBold" />
        </DockPanel>
    </Grid>
</Window>
